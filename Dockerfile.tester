FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /srv

COPY requirements-tester.txt .
RUN pip install --no-cache-dir -r requirements-tester.txt

# The test plan (tests/, fixtures/) and the contract it validates against travel with the tester.
COPY pyproject.toml ./
COPY tester ./tester
COPY tests ./tests
COPY fixtures ./fixtures
COPY openapi ./openapi

RUN useradd --create-home appuser
USER appuser

# TARGETS (JSON {"https://system-base": "api-key"}) is injected at runtime; never committed.
CMD ["sh", "-c", "exec uvicorn tester.main:app --host 0.0.0.0 --port ${PORT:-10000} --proxy-headers --forwarded-allow-ips='*' --no-access-log"]
